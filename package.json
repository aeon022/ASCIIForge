{
  "name": "asciiphreak",
  "version": "0.2.1",
  "description": "ASCII art banners for terminals, READMEs and source files: gradients, borders, comment blocks in 25+ languages, start-up snippets",
  "keywords": [
    "ascii",
    "ascii-art",
    "banner",
    "cli",
    "comment",
    "cyberpunk",
    "developer-tools",
    "figlet",
    "glitch",
    "gradient",
    "hacker",
    "header",
    "motd",
    "phreak",
    "readme",
    "terminal"
  ],
  "homepage": "https://github.com/aeon022/asciiphreak#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aeon022/asciiphreak.git"
  },
  "bugs": {
    "url": "https://github.com/aeon022/asciiphreak/issues"
  },
  "author": "abteilung83 <hello@abteilung83.com>",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "main": "dist/index.js",
  "bin": {
    "asciiphreak": "dist/index.js"
  },
  "files": [
    "dist/**/*",
    "!dist/**/*.test.js",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test test/license.test.js test/comment.test.js test/modules.test.js test/cli.test.js",
    "watch": "tsc -w",
    "start": "ts-node src/index.ts"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^12.0.0",
    "figlet": "^1.7.0",
    "fs-extra": "^11.2.0",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "@types/figlet": "^1.5.8",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.11.0",
    "@types/node-fetch": "^2.6.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
